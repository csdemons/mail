{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RRCKI Mail",
  "version": "0.17.0",
  "identifier": "ru.rrcki.mail",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atom Mail",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "RRCKI",
    "category": "Productivity",
    "shortDescription": "Корпоративный почтовый клиент",
    "linux": {
      "deb": {
        "section": "mail",
        "preInstallScript": "deb/preinst",
        "recommends": ["hunspell-ru", "hunspell-en-us", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "recommends": ["hunspell-ru", "hunspell-en-US", "libayatana-appindicator-gtk3"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "installMode": "both",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": "ru-RU"
      }
    },
    "copyright": "© RRCKI"
  }
}
