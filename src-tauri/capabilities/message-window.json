{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "message-window",
  "description": "Окна писем (msg-*): только команды, нужные для чтения письма, ответа и действий с ним (метка msg в commands.list; файл создаётся из него — не правьте вручную). Окна редактора документов (doc-*) не получают команд вообще.",
  "windows": [
    "msg-*"
  ],
  "permissions": [
    "core:default",
    "allow-list-folders",
    "allow-get-message",
    "allow-set-flag",
    "allow-save-attachment",
    "allow-get-profile",
    "allow-pick-attachments",
    "allow-send-message",
    "allow-send-identities",
    "allow-signatures-get",
    "allow-draft-discard",
    "allow-draft-save",
    "allow-list-contacts",
    "allow-search-contacts",
    "allow-create-contact",
    "allow-nc-status",
    "allow-open-link",
    "allow-nc-files-list",
    "allow-nc-link-for",
    "allow-nc-upload-links",
    "allow-move-messages",
    "allow-create-folder",
    "allow-attachment-data",
    "allow-message-html-remote",
    "allow-signature-get",
    "allow-send-wait",
    "allow-send-cancel",
    "allow-send-now",
    "allow-mdn-respond",
    "allow-categories-get",
    "allow-attach-data",
    "allow-counterparties",
    "allow-forward-attachments",
    "allow-calendar-file-preview",
    "allow-calendar-file-import",
    "allow-attachment-drag-out",
    "allow-attachment-open",
    "allow-mark-spam",
    "allow-unsubscribe",
    "allow-snooze",
    "allow-set-keywords",
    "allow-set-due",
    "allow-templates-list",
    "allow-template-save",
    "allow-get-policy",
    "allow-nc-edit-attachment",
    "allow-close-window",
    "allow-set-zoom",
    "allow-delete-messages",
    "allow-forget-attachment"
  ]
}
