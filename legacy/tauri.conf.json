{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/1.x/core/tauri-config-schema/schema.json",
  "build": {
    "distDir": "../frontend/dist-legacy",
    "devPath": "http://localhost:5173",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "RRCKI Mail",
    "version": "0.43.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true,
        "save": true
      },
      "notification": {
        "all": true
      }
    },
    "bundle": {
      "active": false,
      "identifier": "ru.rrcki.mail",
      "icon": [
        "../src-tauri/icons/32x32.png",
        "../src-tauri/icons/128x128.png",
        "../src-tauri/icons/icon.ico"
      ]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": []
  }
}
